generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SYSTEM_ADMIN    // Full system access, manages all centers and users globally
  CENTER_ADMIN     // Manages a specific center (students, teachers, classes)
  TEACHER          
  STUDENT
}

enum AccountStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  DISABLED
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
}

// Admin model for special admin users (separate from regular User)
// System admins manage the entire platform, center admins manage specific schools/centers
model Admin {
  id                    String            @id @default(cuid())
  email                 String            @unique
  name                  String
  passwordHash          String
  adminType             Role              // SYSTEM_ADMIN or CENTER_ADMIN
  isActive              Boolean           @default(true)
  centerId              String?           // Only for CENTER_ADMIN - references their managed school (School id if applicable)
  lastLoginAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([adminType])
  @@index([email, adminType])
  @@index([centerId])
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String
  passwordHash           String
  accountStatus          AccountStatus            @default(PENDING_EMAIL_VERIFICATION)
  emailVerifiedAt        DateTime?
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  // Relations for regular users (teachers and students)
  teacherProfile         TeacherProfile?
  studentProfile         StudentProfile?
  
  // For teachers: challenges they created, classes they teach
  teacherChallenges      Challenge[]             @relation("TeacherChallenges")
  studentSubmissions     Submission[]            @relation("StudentSubmissions")
  classesTeaching        Class[]                 @relation("TeacherClasses")
  classMemberships       ClassEnrollment[]

  // Verification codes for user authentication
  verificationCodes      VerificationCode[]

  @@index([accountStatus])
}

model VerificationCode {
  id          String                @id @default(cuid())
  userId      String
  code        String
  type        VerificationCodeType
  expiresAt   DateTime
  isUsed      Boolean               @default(false)
  usedAt      DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, isUsed, expiresAt])
  @@index([userId, code, type])
}

enum VerificationCodeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model School {
  id          String      @id @default(cuid())
  name        String
  description String?
  
  // Relationships to other models within this school
  teacherProfiles     TeacherProfile[]
  studentProfiles     StudentProfile[]
  classes             Class[]
  challenges          Challenge[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([name])
}

model AdminCenter {
  id         String                  @id @default(cuid())
  adminId    String            // Reference to Admin.id for CENTER_ADMIN users who manage this center
  schoolId   String          // Reference to School.id - the center they manage
  role       String           // e.g., "OWNER" (admin owns this specific center), or can be added more
  
  createdAt  DateTime     @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([schoolId, adminId])
}

model TeacherProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String
  phoneNumber     String?
  avatarUrl       String?
  bio             String?
  schoolId        String?
  headline        String?
  yearsExperience Int?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  user            User          @relation(fields: [userId], references: [id])
  school          School?      @relation(fields: [schoolId], references: [id])

  @@index([schoolId, userId])
}

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String
  avatarUrl    String?
  bio          String?
  schoolId     String?
  gradeLevel   String?
  learningGoal String?
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  user        User            @relation(fields: [userId], references: [id])
  school      School?         @relation(fields: [schoolId], references: [id])

  @@index([schoolId, userId])
}

model Challenge {
  id             String          @id @default(cuid())
  title          String
  description    String?
  teacherId      String
  schoolId       String?         // Can be at system level or specific to a center's class
  classId        String?
  
  sourceVideoUrl String
  textOverlays   Json            @default("[]")
  answerPeriods  Json            @default("[]")
  status         ChallengeStatus @default(DRAFT)
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  teacher        User          @relation("TeacherChallenges", fields: [teacherId], references: [id])
  school         School?       @relation(fields: [schoolId], references: [id])
  class          Class?        @relation(fields: [classId], references: [id])
  
  submissions    Submission[]

  @@index([teacherId, status])
  @@index([schoolId])
  @@index([classId])
}

model Submission {
  id               String           @id @default(cuid())
  challengeId      String
  studentId        String
  answerMediaUrl   String
  answerSegments   Json            @default("[]")
  renderedVideoUrl String?
  
  status           SubmissionStatus    @default(SUBMITTED)
  score            Int?
  feedbackText     String?
  feedbackVoiceUrl String?
  practiceDurationMs Int?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  challenge        Challenge         @relation(fields: [challengeId], references: [id])
  student          User              @relation("StudentSubmissions", fields: [studentId], references: [id])

  @@index([challengeId, status])
  @@index([studentId])
}

model Class {
  id          String            @id @default(cuid())
  name        String
  description String?
  
  // Center-level organization (School/Center) vs. specific teacher class if needed
  schoolId    String           // For center-managed classes, references the School
  teacherId   String?
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  school      School?          @relation(fields: [schoolId], references: [id])
  teacher     User?            @relation("TeacherClasses", fields: [teacherId], references: [id])

  enrollments ClassEnrollment[]
  challenges  Challenge[]

  @@index([schoolId, teacherId])
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  
  createdAt DateTime          @default(now())
  
  // A class can have multiple students (e.g., all in a center's shared classes)
  class     Class    @relation(fields: [classId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])

  @@unique([classId, studentId])
}
